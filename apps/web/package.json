{
  "name": "@assessiq/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-brand-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-brand-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test",
    "lhci:run": "lhci autorun",
    "lhci:authed": "tsx e2e/lighthouse-authed.mjs",
    "visual:run": "playwright test --project=visual",
    "visual:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@assessiq/admin-dashboard": "workspace:*",
    "@assessiq/candidate-ui": "workspace:*",
    "@assessiq/help-system": "workspace:*",
    "@assessiq/http-client": "workspace:*",
    "@assessiq/question-types": "workspace:*",
    "@assessiq/ui-system": "workspace:*",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  }
}
