---
// tools/percentile-calculator.astro — Percentile calculator (/tools/percentile-calculator)
// Client-side calculator. Runs entirely in the browser; no data is sent or stored.
// Percentage = score / total marks. Percentile rank = (scores below + half of scores equal) / group size.
// Schemas as separate blocks: Article, FAQPage, BreadcrumbList.
// Page dates come from src/data/page-dates.json (needs an entry for this path).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageDates } from '../../lib/page-dates';

const site = 'https://assessiq.in';
const path = '/tools/percentile-calculator';
const dates = getPageDates(path);

const faqItems = [
  {
    q: 'What is a percentile?',
    a: 'A percentile shows where a score sits within a group. A score at the 80th percentile is at or above about 80 out of every 100 scores in that group.'
  },
  {
    q: 'What is the difference between a percentile and a percentage?',
    a: 'A percentage is your score divided by the total marks. A percentile is your rank within a group of scores. You can score 60% and still be near the top of a group if the other scores were lower.'
  },
  {
    q: 'How are ties handled?',
    a: 'Each score that equals yours counts as half a score below yours. For example, if 10 scores are below yours and 4 scores are equal to yours, the count is 10 + (4 ÷ 2) = 12. That count is divided by the group size and multiplied by 100.'
  },
  {
    q: 'Does this tool store my data?',
    a: 'No. The tool runs in your browser. Nothing you type or paste is sent to AssessIQ or any other server, and nothing is saved.'
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${site}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Free Tools",
      "item": `${site}/tools`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Percentile Calculator"
      // no "item" on last breadcrumb per SEO §15 spec
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Percentile Calculator",
  "description": "Work out a score's percentage and its percentile rank within a group of scores. Runs in your browser. No sign-up, and no data is sent.",
  "url": `${site}${path}`,
  "mainEntityOfPage": `${site}${path}`,
  "datePublished": dates.published,
  "dateModified": dates.modified,
  "author": { "@type": "Organization", "name": "AssessIQ" },
  "publisher": { "@type": "Organization", "name": "AssessIQ", "url": `${site}/` }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<BaseLayout
  title="Percentile Calculator"
  description="Calculate a score's percentage and its percentile rank within a group of scores. Runs in your browser. No sign-up, and no data is sent."
  canonicalPath={path}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Breadcrumb nav -->
  <nav aria-label="Breadcrumb" class="border-b border-aiq-border bg-aiq-bg-raised">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-sm">
      <ol class="flex items-center gap-aiq-sm list-none m-0 p-0">
        <li>
          <a href="/" class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase hover:text-aiq-fg-secondary transition-colors">
            Home
          </a>
        </li>
        <li aria-hidden="true" class="font-mono text-aiq-xs text-aiq-fg-muted">&rsaquo;</li>
        <li>
          <a href="/tools" class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase hover:text-aiq-fg-secondary transition-colors">
            Free Tools
          </a>
        </li>
        <li aria-hidden="true" class="font-mono text-aiq-xs text-aiq-fg-muted">&rsaquo;</li>
        <li>
          <span class="font-mono text-aiq-xs text-aiq-fg-secondary tracking-aiq-mono uppercase" aria-current="page">
            Percentile Calculator
          </span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-aiq-bg-base border-b border-aiq-border">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">
      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-lg m-0">
        Free Calculator &middot; Browser-based
      </p>
      <h1 class="font-serif text-aiq-3xl sm:text-aiq-hero font-normal tracking-aiq-tighter text-aiq-fg-primary leading-[1.05] mb-aiq-xl mt-0 max-w-3xl">
        What is a score's percentile?
      </h1>
      <p class="font-sans text-aiq-lg text-aiq-fg-secondary leading-relaxed mb-0 max-w-2xl">
        Enter a score and the total marks to get the percentage. Paste a group of scores to get the percentile rank. The calculation runs in your browser. No sign-up. No data is sent anywhere.
      </p>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="bg-aiq-bg-raised border-b border-aiq-border" aria-labelledby="calc-heading">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">
      <h2 id="calc-heading" class="sr-only">Calculator inputs and results</h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-aiq-3xl items-start">

        <!-- Inputs -->
        <div class="bg-aiq-bg-base border border-aiq-border rounded-aiq-lg p-aiq-xl">

          <form id="pct-form" novalidate>

            <!-- Score -->
            <div class="mb-aiq-xl">
              <label for="score" class="block font-sans text-aiq-sm font-medium text-aiq-fg-primary mb-aiq-xs">
                Candidate's score
              </label>
              <p id="score-hint" class="font-sans text-aiq-xs text-aiq-fg-muted m-0 mb-aiq-sm">
                The marks the candidate got. Use a number, for example 34.
              </p>
              <input
                type="number"
                id="score"
                name="score"
                min="0"
                step="any"
                inputmode="decimal"
                aria-describedby="score-hint"
                class="w-full font-sans text-aiq-md text-aiq-fg-primary bg-aiq-bg-base border border-aiq-border-strong
                       rounded-aiq-md px-aiq-md py-aiq-sm focus:outline-none focus:ring-2 focus:ring-aiq-accent
                       focus:border-transparent"
              />
            </div>

            <!-- Total marks -->
            <div class="mb-aiq-xl">
              <label for="total" class="block font-sans text-aiq-sm font-medium text-aiq-fg-primary mb-aiq-xs">
                Total marks
              </label>
              <p id="total-hint" class="font-sans text-aiq-xs text-aiq-fg-muted m-0 mb-aiq-sm">
                The highest score possible on the test. Use a number above 0, for example 50.
              </p>
              <input
                type="number"
                id="total"
                name="total"
                min="0"
                step="any"
                inputmode="decimal"
                aria-describedby="total-hint"
                class="w-full font-sans text-aiq-md text-aiq-fg-primary bg-aiq-bg-base border border-aiq-border-strong
                       rounded-aiq-md px-aiq-md py-aiq-sm focus:outline-none focus:ring-2 focus:ring-aiq-accent
                       focus:border-transparent"
              />
            </div>

            <!-- Cohort scores -->
            <div class="mb-aiq-xl">
              <label for="cohort" class="block font-sans text-aiq-sm font-medium text-aiq-fg-primary mb-aiq-xs">
                Group scores (optional)
              </label>
              <p id="cohort-hint" class="font-sans text-aiq-xs text-aiq-fg-muted m-0 mb-aiq-sm">
                Paste the other scores in the group. Separate them with commas or new lines, for example 12, 18, 34, 40.
              </p>
              <textarea
                id="cohort"
                name="cohort"
                rows="6"
                aria-describedby="cohort-hint"
                class="w-full font-sans text-aiq-md text-aiq-fg-primary bg-aiq-bg-base border border-aiq-border-strong
                       rounded-aiq-md px-aiq-md py-aiq-sm focus:outline-none focus:ring-2 focus:ring-aiq-accent
                       focus:border-transparent"
              ></textarea>
            </div>

            <button
              type="submit"
              class="font-sans text-aiq-md font-medium px-6 py-3 rounded-aiq-pill bg-aiq-accent text-white
                     hover:bg-aiq-accent-hover transition-colors duration-150
                     focus:outline-none focus-visible:ring-2 focus-visible:ring-aiq-accent focus-visible:ring-offset-2"
            >
              Calculate
            </button>

          </form>
        </div>

        <!-- Results -->
        <div class="bg-aiq-bg-base border border-aiq-border rounded-aiq-lg p-aiq-xl sticky top-20">

          <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-lg mt-0 font-medium">
            Results
          </p>

          <div id="pct-result" aria-live="polite" class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">
            Enter a score and the total marks, then select Calculate.
          </div>

          <p class="font-sans text-aiq-xs text-aiq-fg-muted leading-relaxed mt-aiq-lg mb-0">
            This tool gives a simple estimate from the numbers you enter. It does not check the test or the candidate.
          </p>

        </div>

      </div>

    </div>
  </section>

  <!-- HOW TO READ THIS -->
  <section class="bg-aiq-bg-base border-b border-aiq-border" aria-labelledby="read-heading">
    <div class="max-w-3xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">How the numbers work</p>
      <h2 id="read-heading" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
        Two numbers, two questions.
      </h2>

      <div class="flex flex-col gap-aiq-xl">

        <div>
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            Percentage
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            Score divided by total marks, times 100. It answers: how many marks did the candidate get out of the total?
          </p>
        </div>

        <div>
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            Percentile rank
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            Count the group scores below the candidate's score. Add half of the group scores that are equal to it. Divide that number by the group size, then multiply by 100. It answers: how does the candidate compare with the group?
          </p>
        </div>

        <div>
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            Reading the result
          </h3>
          <ul class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0 pl-aiq-lg flex flex-col gap-aiq-sm">
            <li>A high percentile means the score is above most of the group.</li>
            <li>A low percentile means the score is below most of the group.</li>
            <li>The group must be a fair match. Small or mixed groups give less useful ranks.</li>
            <li>Do not use a percentile alone to make a decision.</li>
          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-aiq-bg-raised border-b border-aiq-border" aria-labelledby="faq-heading">
    <div class="max-w-3xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">Questions</p>
      <h2 id="faq-heading" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
        Frequently asked questions
      </h2>

      <div class="flex flex-col gap-aiq-xl">
        {faqItems.map((item) => (
          <div>
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
              {item.q}
            </h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              {item.a}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- RELATED LINKS -->
  <section class="bg-aiq-bg-base">
    <div class="max-w-3xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">Keep reading</p>
      <div class="flex flex-wrap gap-aiq-lg">
        <a href="/glossary/percentile-rank" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">
          Percentile rank in the glossary &rarr;
        </a>
        <a href="/tests" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">
          Browse tests &rarr;
        </a>
        <a href="/tools" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">
          All free tools &rarr;
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<!-- Calculator logic — vanilla JS, runs in browser, no framework, no network calls -->
<script is:inline>
(function () {
  var form = document.getElementById('pct-form');
  var out = document.getElementById('pct-result');
  var scoreEl = document.getElementById('score');
  var totalEl = document.getElementById('total');
  var cohortEl = document.getElementById('cohort');

  function ordinal(n) {
    var m = n % 100;
    if (m >= 11 && m <= 13) return n + 'th';
    switch (n % 10) {
      case 1: return n + 'st';
      case 2: return n + 'nd';
      case 3: return n + 'rd';
      default: return n + 'th';
    }
  }

  function toNumber(text) {
    var s = String(text).trim();
    if (s === '') return NaN;
    return Number(s);
  }

  function parseCohort(text) {
    var parts = text.split(/[,\n\r]+/);
    var scores = [];
    var bad = 0;
    for (var i = 0; i < parts.length; i++) {
      var p = parts[i].trim();
      if (p === '') continue;
      var v = toNumber(p);
      if (!isFinite(v) || v < 0) { bad++; continue; }
      scores.push(v);
    }
    return { scores: scores, bad: bad };
  }

  function showError(message) {
    out.textContent = message;
  }

  function calculate() {
    var score = toNumber(scoreEl.value);
    var total = toNumber(totalEl.value);

    if (!isFinite(score) || score < 0) {
      showError('Enter the candidate\'s score as a number of 0 or more.');
      scoreEl.focus();
      return;
    }
    if (!isFinite(total) || total <= 0) {
      showError('Enter the total marks as a number above 0.');
      totalEl.focus();
      return;
    }
    if (score > total) {
      showError('The score cannot be more than the total marks.');
      scoreEl.focus();
      return;
    }

    var percent = Math.round((score / total) * 1000) / 10;
    var parsed = parseCohort(cohortEl.value);

    var html = '';
    html += '<p class="font-mono text-aiq-xs text-aiq-accent uppercase tracking-aiq-mono mt-0 mb-aiq-xs">Percentage</p>';
    html += '<p class="font-serif text-aiq-hero font-normal tracking-aiq-tighter text-aiq-accent m-0 leading-none mb-aiq-lg">' + percent + '%</p>';

    if (parsed.bad > 0) {
      html += '<p class="font-sans text-aiq-sm text-aiq-fg-secondary mb-aiq-md">' + parsed.bad + (parsed.bad === 1 ? ' entry was' : ' entries were') + ' skipped because ' + (parsed.bad === 1 ? 'it is' : 'they are') + ' not a number of 0 or more.</p>';
    }

    if (parsed.scores.length === 0) {
      html += '<p class="font-sans text-aiq-sm text-aiq-fg-secondary m-0">Paste the group scores to see the percentile rank.</p>';
      out.innerHTML = html;
      return;
    }

    var below = 0;
    var equal = 0;
    for (var i = 0; i < parsed.scores.length; i++) {
      if (parsed.scores[i] < score) below++;
      else if (parsed.scores[i] === score) equal++;
    }
    var n = parsed.scores.length;
    var rank = Math.round(((below + 0.5 * equal) / n) * 100);

    html += '<p class="font-mono text-aiq-xs text-aiq-fg-muted uppercase tracking-aiq-mono mt-0 mb-aiq-xs">Percentile rank in the group</p>';
    html += '<p class="font-serif text-aiq-hero font-normal tracking-aiq-tighter text-aiq-fg-primary m-0 leading-none mb-aiq-lg">' + ordinal(rank) + ' percentile</p>';
    html += '<ul class="font-sans text-aiq-sm text-aiq-fg-secondary m-0 pl-aiq-lg flex flex-col gap-aiq-xs">';
    html += '<li>Group scores in the list: ' + n + '</li>';
    html += '<li>Group scores below the candidate: ' + below + '</li>';
    html += '<li>Group scores equal to the candidate: ' + equal + ' (each counts as half)</li>';
    html += '</ul>';
    html += '<p class="font-sans text-aiq-xs text-aiq-fg-muted mt-aiq-md mb-0">Percentile = (below + half of equal) &divide; group size &times; 100, rounded to a whole number.</p>';

    out.innerHTML = html;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    calculate();
  });
})();
</script>
