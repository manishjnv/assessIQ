---
// solutions/educational-institutions.astro — Educational Institutions solution page
// JSON-LD: THREE separate blocks — Service, FAQPage, BreadcrumbList (per SEO §3.6 / §15 template)
// NO aggregateRating — omitted until real G2/Capterra reviews exist (SEO §13 hard rule)
// India-first positioning per SEO §17: colleges/universities — online exams, skill certification
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = 'https://assessiq.in';

// Service JSON-LD (§15 template)
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Online examination and skill assessment for educational institutions",
  "provider": {
    "@type": "Organization",
    "name": "AssessIQ"
  },
  "areaServed": ["India", "Worldwide"],
  "description": "Online exam and skill certification platform for colleges and universities in India. Run skill certification tests and outcome assessments with server-side timers and certificates that anyone can verify online.",
  "url": `${site}/solutions/educational-institutions`
};

// FAQPage JSON-LD — mirrors the visible FAQ section verbatim (SEO §15 hard rule)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can AssessIQ be used for online tests and examinations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AssessIQ supports timed online assessments with multiple-choice (scored deterministically), scenario, and written-answer questions. Timers are enforced on the server and start when the student begins and consents. Every attempt is logged and auditable. Basic integrity controls are included (optional fullscreen gate, copy/paste blocking, tab-switch warning). Webcam proctoring and a lockdown browser are not available."
      }
    },
    {
      "@type": "Question",
      "name": "What integrity controls are available for online exams?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AssessIQ randomises question order, shuffles MCQ options per student, enforces server-side timers, and issues invite links to individual students. Correct answers are never exposed to candidates. It also has an optional fullscreen gate, copy/paste blocking and a tab-switch warning. There is no webcam proctoring and no lockdown browser."
      }
    },
    {
      "@type": "Question",
      "name": "How does AssessIQ handle skill certification for students?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AssessIQ issues certificates for assessments taken on the platform, each with a public verification page. An employer or institution receiving a certificate can confirm it is genuine. Credential sharing is candidate-controlled."
      }
    },
    {
      "@type": "Question",
      "name": "Can we use AssessIQ for outcome assessment and accreditation reporting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AssessIQ produces cohort-level reports showing score distributions, pass rates, and per-competency breakdowns. These exports are designed to support programme-level outcome analysis — useful for NAAC, NBA, and similar accreditation frameworks that require evidence of learning outcomes. The platform does not generate accreditation reports automatically; institutions use the data exports in their own reporting workflows."
      }
    },
    {
      "@type": "Question",
      "name": "Where is candidate data stored?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Candidate data and assessment results are held on managed infrastructure with tenant isolation enforced at the database layer. AssessIQ is built with India's Digital Personal Data Protection Act (DPDP) in mind. Written answers evaluated with AI assistance are sent to Anthropic's Claude service in the United States. Ask us if you have specific data-location requirements."
      }
    },
    {
      "@type": "Question",
      "name": "Does AssessIQ require candidates to install any software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. AssessIQ is entirely browser-based. Students need a modern browser and a stable internet connection. No desktop client, plugin, or app installation is required — which makes BYOD exam setups and remote examination straightforward to administer."
      }
    }
  ]
};

// BreadcrumbList JSON-LD (§15 — last item has NO `item` URL per spec)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${site}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Solutions",
      "item": `${site}/solutions`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Educational Institutions"
      // NOTE: no "item" on current/last breadcrumb per SEO §15 spec
    }
  ]
};

// Capability cards
const capabilities = [
  {
    label: "Fair Online Exams",
    body: "Randomised question order, per-student option shuffle, server-side timers, and a full audit log. Optional fullscreen gate, copy/paste blocking and tab-switch warning; no webcam proctoring or lockdown browser."
  },
  {
    label: "Question Types",
    body: "MCQ scored deterministically, plus scenario and written-answer questions evaluated with AI assistance by AssessIQ evaluators."
  },
  {
    label: "Skill Certification",
    body: "Issue certificates with a public verification page, linked to the assessment attempt. Students share them; employers can verify them."
  },
  {
    label: "Outcome Assessment Reports",
    body: "Score distributions, pass rates, and per-competency breakdowns at cohort level. Export data for NAAC, NBA, or internal programme review."
  },
  {
    label: "Bulk Invite",
    body: "Import students from CSV (up to 1,000 rows per file, or 200 when the same import also sends invitations) and send invite links by email, valid for 7 days, with single and bulk resend."
  },
  {
    label: "Data Protection",
    body: "Tenant isolation at the database layer and an append-only audit log. Built with DPDP requirements in mind."
  }
];

// Who this page is for
const useCases = [
  {
    label: "Academic Institutions",
    heading: "Run exams online with a clear audit trail.",
    body: "Replace in-hall paper exams with an online alternative — or supplement them with skill assessments that measure what graduates can actually do, not just what they memorise."
  },
  {
    label: "Examination Departments",
    heading: "An audit trail for every attempt.",
    body: "Timestamped attempt logs and per-answer scoring rationale are available for every submitted paper. If a result is disputed, the evidence is there."
  },
  {
    label: "Placement & Career Cells",
    heading: "Certify skills, not just grades.",
    body: "Issue skill certificates tied to assessed competencies that students can take to recruiters alongside their transcript."
  }
];
---

<BaseLayout
  title="Online Exams for Educational Institutions"
  description="AssessIQ provides online exam and skill certification tools for colleges and universities in India. Server-side timers, certificates with public verification, and cohort reports."
  canonicalPath="/solutions/educational-institutions"
>
  <!-- JSON-LD: Service (separate block per §3.6) -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <!-- JSON-LD: FAQPage (separate block per §3.6) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- JSON-LD: BreadcrumbList (separate block per §3.6) -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Breadcrumb nav — visible, matches JSON-LD (SEO §3.8) -->
  <nav aria-label="Breadcrumb" class="border-b border-aiq-border bg-aiq-bg-raised">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-sm">
      <ol class="flex items-center gap-aiq-sm list-none m-0 p-0">
        <li>
          <a href="/" class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase hover:text-aiq-fg-secondary transition-colors">
            Home
          </a>
        </li>
        <li aria-hidden="true" class="font-mono text-aiq-xs text-aiq-fg-muted">&rsaquo;</li>
        <li>
          <a href="/solutions" class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase hover:text-aiq-fg-secondary transition-colors">Solutions</a>
        </li>
        <li aria-hidden="true" class="font-mono text-aiq-xs text-aiq-fg-muted">&rsaquo;</li>
        <li>
          <span class="font-mono text-aiq-xs text-aiq-fg-secondary tracking-aiq-mono uppercase" aria-current="page">
            Educational Institutions
          </span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- ── HERO ── -->
  <section class="bg-aiq-bg-base border-b border-aiq-border">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-lg m-0">
        Solution &middot; Educational Institutions
      </p>

      <h1 class="font-serif text-aiq-3xl sm:text-aiq-hero font-normal tracking-aiq-tighter text-aiq-fg-primary leading-[1.05] mb-aiq-xl mt-0 max-w-3xl">
        Online examinations your institution can stand behind.
      </h1>

      <!-- Featured-snippet target: 40–60 word definitional intro -->
      <p class="font-sans text-aiq-lg text-aiq-fg-secondary leading-relaxed mb-aiq-2xl max-w-2xl">
        AssessIQ is an online exam and skill certification platform for colleges and universities in India. It runs timed assessments with server-side timers and certificates anyone can verify — so results are defensible and meaningful.
      </p>

      <div class="flex flex-wrap items-center gap-aiq-md">
        <a
          href="/contact"
          class="font-sans text-aiq-md font-medium px-6 py-3 rounded-aiq-pill bg-aiq-accent text-white
                 hover:bg-aiq-accent-hover transition-colors duration-150
                 focus:outline-none focus-visible:ring-2 focus-visible:ring-aiq-accent focus-visible:ring-offset-2"
        >
          Request a demo
        </a>
        <a
          href="/contact"
          class="font-sans text-aiq-md font-medium px-6 py-3 rounded-aiq-pill border border-aiq-border-strong
                 text-aiq-fg-primary hover:border-aiq-accent hover:text-aiq-accent transition-colors duration-150
                 focus:outline-none focus-visible:ring-2 focus-visible:ring-aiq-accent focus-visible:ring-offset-2"
        >
          Talk to us
        </a>
      </div>

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mt-aiq-2xl mb-0">
        For engineering colleges &middot; universities &middot; professional institutes &middot; autonomous boards
      </p>

    </div>
  </section>

  <!-- ── THE PROBLEM ── -->
  <section class="bg-aiq-bg-raised border-b border-aiq-border" aria-labelledby="problem-heading">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">
      <div class="max-w-3xl">
        <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">The problem</p>
        <h2 id="problem-heading" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
          Moving exams online without losing integrity is the hard part.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-aiq-2xl">
          <div>
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
              Degrees without demonstrated competency.
            </h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              Marks from traditional examinations often measure memory under time pressure. Employers increasingly want evidence that graduates can apply skills — which requires a different type of assessment, not just a different medium for the same paper.
            </p>
          </div>
          <div>
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
              Remote exams that can't be trusted.
            </h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              Online exams are easy to game when every student sees the same questions in the same order. Randomised ordering, per-student option shuffle, and an auditable record of every attempt help — and basic integrity controls (fullscreen gate, copy/paste blocking, tab-switch warning) add to that. There is no webcam proctoring or lockdown browser.
            </p>
          </div>
          <div>
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
              Credentials that employers can't verify.
            </h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              A PDF certificate issued by a college says nothing about what was assessed, at what standard, or whether the result is genuine. A certificate with a public verification page, linked to an auditable attempt and a structured rubric, says all three.
            </p>
          </div>
          <div>
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
              Outcome data in the wrong format for accreditation.
            </h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              NAAC and NBA frameworks require evidence of programme learning outcomes. AssessIQ provides cohort-level score reports and CSV exports that institutions can use in their own outcome reporting.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CAPABILITIES ── -->
  <section class="bg-aiq-bg-base border-b border-aiq-border" aria-labelledby="capabilities-heading">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">What AssessIQ does</p>
      <h2 id="capabilities-heading" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-3xl mt-0">
        Everything educational institutions need to assess with confidence.
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-aiq-lg">
        {capabilities.map(cap => (
          <div class="bg-aiq-bg-raised border border-aiq-border rounded-aiq-lg p-aiq-xl hover:border-aiq-border-strong transition-colors duration-150">
            <p class="font-mono text-aiq-xs text-aiq-accent tracking-aiq-mono uppercase mb-aiq-sm mt-0 font-medium">
              {cap.label}
            </p>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              {cap.body}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── WHO IT'S FOR ── -->
  <section class="bg-aiq-bg-raised border-b border-aiq-border" aria-labelledby="usecases-heading">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">Who it's for</p>
      <h2 id="usecases-heading" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-3xl mt-0">
        Built for institutions that take assessment seriously.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-aiq-lg">
        {useCases.map(uc => (
          <div class="bg-aiq-bg-base border border-aiq-border rounded-aiq-lg p-aiq-xl">
            <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md mt-0">
              {uc.label}
            </p>
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0 leading-snug">
              {uc.heading}
            </h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              {uc.body}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="bg-aiq-bg-base border-b border-aiq-border" aria-labelledby="faq-heading">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">FAQ</p>
      <h2 id="faq-heading" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-3xl mt-0">
        Common questions from educational institutions.
      </h2>

      <div class="flex flex-col gap-aiq-xl max-w-3xl">

        <div class="border-b border-aiq-border pb-aiq-xl">
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            Can AssessIQ be used for online tests and examinations?
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            AssessIQ supports timed online assessments with multiple-choice (scored deterministically), scenario, and written-answer questions. Timers are enforced on the server and start when the student begins and consents. Every attempt is logged and auditable. Basic integrity controls are included (optional fullscreen gate, copy/paste blocking, tab-switch warning). Webcam proctoring and a lockdown browser are not available.
          </p>
        </div>

        <div class="border-b border-aiq-border pb-aiq-xl">
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            What integrity controls are available for online exams?
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            AssessIQ randomises question order, shuffles MCQ options per student, enforces server-side timers, and issues invite links to individual students. Correct answers are never exposed to candidates. It also has an optional fullscreen gate, copy/paste blocking and a tab-switch warning. There is no webcam proctoring and no lockdown browser.
          </p>
        </div>

        <div class="border-b border-aiq-border pb-aiq-xl">
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            How does AssessIQ handle skill certification for students?
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            AssessIQ issues certificates for assessments taken on the platform, each with a public verification page. An employer or institution receiving a certificate can confirm it is genuine. Credential sharing is candidate-controlled.
          </p>
        </div>

        <div class="border-b border-aiq-border pb-aiq-xl">
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            Can we use AssessIQ for outcome assessment and accreditation reporting?
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            AssessIQ produces cohort-level reports showing score distributions, pass rates, and per-competency breakdowns. These exports are designed to support programme-level outcome analysis — useful for NAAC, NBA, and similar accreditation frameworks that require evidence of learning outcomes. The platform does not generate accreditation reports automatically; institutions use the data exports in their own reporting workflows.
          </p>
        </div>

        <div class="border-b border-aiq-border pb-aiq-xl">
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            Where is candidate data stored?
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            Candidate data and assessment results are held on managed infrastructure with tenant isolation enforced at the database layer. AssessIQ is built with India's Digital Personal Data Protection Act (DPDP) in mind. Written answers evaluated with AI assistance are sent to Anthropic's Claude service in the United States. Ask us if you have specific data-location requirements.
          </p>
        </div>

        <div>
          <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">
            Does AssessIQ require candidates to install any software?
          </h3>
          <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
            No. AssessIQ is entirely browser-based. Students need a modern browser and a stable internet connection. No desktop client, plugin, or app installation is required — which makes BYOD exam setups and remote examination straightforward to administer.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── EXPLORE OTHER SOLUTIONS + CTA ── -->
  <section class="bg-aiq-bg-raised" aria-labelledby="related-heading">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-aiq-4xl items-start">

        <!-- CTA -->
        <div>
          <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">Get started</p>
          <h2 class="font-serif text-aiq-2xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
            Ready to bring your institution's assessments online?
          </h2>
          <div class="flex flex-wrap gap-aiq-md mb-aiq-2xl">
            <a
              href="/contact"
              class="font-sans text-aiq-md font-medium px-6 py-3 rounded-aiq-pill bg-aiq-accent text-white
                     hover:bg-aiq-accent-hover transition-colors duration-150
                     focus:outline-none focus-visible:ring-2 focus-visible:ring-aiq-accent focus-visible:ring-offset-2"
            >
              Request a demo
            </a>
            <a
              href="/contact"
              class="font-sans text-aiq-md font-medium px-6 py-3 rounded-aiq-pill border border-aiq-border-strong
                     text-aiq-fg-primary hover:border-aiq-accent hover:text-aiq-accent transition-colors duration-150
                     focus:outline-none focus-visible:ring-2 focus-visible:ring-aiq-accent focus-visible:ring-offset-2"
            >
              Talk to us
            </a>
          </div>
          <p class="font-sans text-aiq-sm text-aiq-fg-muted leading-relaxed m-0">
            Questions about data protection or DPDP? See the <a href="/security" class="text-aiq-accent hover:text-aiq-accent-hover underline underline-offset-2">security page</a> or <a href="/pricing" class="text-aiq-accent hover:text-aiq-accent-hover underline underline-offset-2">pricing</a>.
          </p>
        </div>

        <!-- Other solutions -->
        <div>
          <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">Other solutions</p>
          <h2 id="related-heading" class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-lg mt-0">
            AssessIQ across every assessment context.
          </h2>
          <ul class="list-none m-0 p-0 flex flex-col gap-aiq-md">
            <li>
              <a href="/solutions/it-hiring" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">
                IT &amp; Technical Hiring
              </a>
              <p class="font-sans text-aiq-sm text-aiq-fg-muted m-0 mt-aiq-xs">Aptitude and skills assessments for IT companies.</p>
            </li>
            <li>
              <a href="/solutions/campus-recruitment" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">
                Campus &amp; Fresher Recruitment
              </a>
              <p class="font-sans text-aiq-sm text-aiq-fg-muted m-0 mt-aiq-xs">Aptitude assessments at bulk scale for campus placement drives.</p>
            </li>
            <li>
              <a href="/solutions/team-skill-gap" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">
                Team Skill-Gap Analysis
              </a>
              <p class="font-sans text-aiq-sm text-aiq-fg-muted m-0 mt-aiq-xs">Map your existing team's competencies and identify upskilling priorities.</p>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
