        <li>
          <span class="font-mono text-aiq-xs text-aiq-fg-secondary tracking-aiq-mono uppercase" aria-current="page">
            AssessIQ vs Mercer Mettl
          </span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- ── HERO ── -->
  <section class="bg-aiq-bg-base border-b border-aiq-border">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-lg m-0">
        Compare &middot; Updated {formatDate(dates.modified)}
      </p>

      <h1 class="font-serif text-aiq-3xl sm:text-aiq-hero font-normal tracking-aiq-tighter text-aiq-fg-primary leading-[1.05] mb-aiq-xl mt-0 max-w-3xl">
        AssessIQ vs Mercer Mettl: Complete 2026 Comparison
      </h1>

      <!-- 50-word TL;DR — snippet target per §5.3 -->
      <div class="bg-aiq-bg-raised border border-aiq-border rounded-aiq-lg p-aiq-xl mb-aiq-2xl max-w-2xl">
        <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-sm mt-0">TL;DR</p>
        <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
          AssessIQ offers structured, rubric-based hiring assessments built for Indian IT teams — anchor scoring, audit trails, and a simple admin workflow. Mercer Mettl brings a larger question library, proctoring at enterprise scale, and global reach backed by Mercer. The right choice depends on whether you need breadth or structured-scoring depth.
        </p>
      </div>

      <!-- Internal links row -->
      <p class="font-sans text-aiq-sm text-aiq-fg-muted leading-relaxed m-0">
        Also compare: <a href="/compare/assessiq-vs-hackerearth" class="text-aiq-accent hover:text-aiq-accent-hover underline underline-offset-2">AssessIQ vs HackerEarth</a> &middot; <a href="/compare/assessiq-vs-imocha" class="text-aiq-accent hover:text-aiq-accent-hover underline underline-offset-2">AssessIQ vs iMocha</a> &middot; <a href="/alternatives/mettl" class="text-aiq-accent hover:text-aiq-accent-hover underline underline-offset-2">Mercer Mettl alternatives</a>
      </p>

    </div>
  </section>

  <!-- ── SIDE-BY-SIDE TABLE ── -->
  <section class="bg-aiq-bg-raised border-b border-aiq-border" aria-labelledby="table-heading">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-4xl">

      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md m-0">Side-by-side</p>
