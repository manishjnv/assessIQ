              <th class="font-mono text-aiq-xs text-aiq-accent tracking-aiq-mono uppercase pb-aiq-md pr-aiq-xl w-[37.5%]">AssessIQ</th>
              <th class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase pb-aiq-md w-[37.5%]">Mercer Mettl</th>
            </tr>
          </thead>
          <tbody>
            {tableRows.map((row, i) => (
              <tr class={`border-b border-aiq-border ${i % 2 === 0 ? 'bg-aiq-bg-base' : 'bg-aiq-bg-raised'}`}>
                <td class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase py-aiq-lg pr-aiq-xl align-top font-medium">
                  {row.criterion}
                </td>
                <td class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed py-aiq-lg pr-aiq-xl align-top">
