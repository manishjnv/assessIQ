---
// compare/assessiq-vs-mettl.astro — /compare/assessiq-vs-mettl
// JSON-LD: THREE separate blocks — Article, FAQPage, BreadcrumbList (per SEO §3.6 / §5.3 / §15)
// NO aggregateRating — omitted until real G2/Capterra reviews exist (SEO §13 hard rule)
// NO specific price claims for either platform (anti-fabrication rule)
// Competitor facts sourced from publicly verifiable information (2025-2026)
import { getPageDates, formatDate } from '../../lib/page-dates';
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = 'https://assessiq.in';
const dates = getPageDates('/compare/assessiq-vs-mettl');

// Article JSON-LD (§15 template — comparison pages use Article)
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "AssessIQ vs Mercer Mettl: Complete 2026 Comparison",
  "datePublished": dates.published,
  "dateModified": dates.modified,
  "author": {
    "@type": "Organization",
    "name": "AssessIQ",
    "url": `${site}/`
  },
  "publisher": {
    "@type": "Organization",
    "name": "AssessIQ",
    "logo": {
      "@type": "ImageObject",
      "url": `${site}/favicon.svg`
    }
  },
  "mainEntityOfPage": `${site}/compare/assessiq-vs-mettl`,
  "description": "An honest, side-by-side comparison of AssessIQ and Mercer Mettl across proctoring, India focus, question types, code evaluation, integrations, deployment, support, and ideal customer — updated May 2026."
};

// FAQPage JSON-LD — mirrors the visible FAQ section verbatim (SEO §15 hard rule)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Mercer Mettl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mercer Mettl (now branded Mercer | Mettl) is an online talent assessment and proctoring platform headquartered in Gurugram, India. It was acquired by Mercer in 2018. The platform is known for a broad assessment library, AI-powered proctoring, and enterprise-scale examination delivery used by 6,000+ companies globally."
      }
    },
    {
      "@type": "Question",
      "name": "How does AssessIQ differ from Mercer Mettl for Indian IT companies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AssessIQ is designed specifically for structured, auditable B2B hiring decisions — with anchor-based rubrics, scoring bands, and full attempt logs that let teams defend every shortlist decision. Mercer Mettl offers a wider enterprise assessment library and a large-scale proctoring infrastructure. For Indian IT companies that need a focused screening workflow with transparent scoring rationale, AssessIQ is the more direct fit. For enterprise exam programs, certification delivery, or very large question library breadth, Mercer Mettl is worth evaluating."
      }
    },
    {
      "@type": "Question",
      "name": "Does AssessIQ support AI-powered proctoring like Mercer Mettl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AssessIQ has basic integrity controls (an optional fullscreen gate, copy/paste blocking and a tab-switch warning, recorded for the admin) but no webcam proctoring and no lockdown browser; it also has server-side timers, an append-only audit log, and role-separated access. Mercer Mettl is known for AI-powered proctoring at very large scale. The right choice depends on the scale of your exam program and what oversight the proctoring output needs to support."
      }
    },
    {
      "@type": "Question",
      "name": "Is Mercer Mettl suitable for small and mid-size Indian companies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mercer Mettl serves a wide range of business sizes from startups to enterprises. Some user reviews note that pricing can be a consideration for smaller organizations. AssessIQ is designed with Indian team sizes and hiring workflows in mind. Both platforms are worth evaluating based on your volume and feature requirements — check current pricing directly with each vendor."
      }
    },
    {
      "@type": "Question",
      "name": "Which platform has a larger question library — AssessIQ or Mercer Mettl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mercer Mettl publicly states a library of 100,000+ technical questions across many domains. AssessIQ ships a smaller set of curated question packs, including an aptitude pack; more technical packs (Python, Java, SQL, React) are coming soon. If raw library count is the primary criterion, Mercer Mettl has far more volume."
      }
    },
    {
      "@type": "Question",
      "name": "How can I evaluate AssessIQ before committing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contact us and we will set up a company account so you can run a real assessment against your hiring workflow before deciding."
      }
    }
  ]
};

// BreadcrumbList JSON-LD (§15 — last item has NO `item` URL per spec)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${site}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Compare",
      "item": `${site}/compare`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "AssessIQ vs Mercer Mettl"
      // NOTE: no "item" on current/last breadcrumb per SEO §15 spec
    }
  ]
};

// Comparison table rows — neutral criteria, honest entries, no absolute "lacks X" claims
const tableRows = [
  {
    criterion: "India focus",
    assessiq: "Built for Indian hiring and campus programs — structured scoring, audit trail, and an aptitude question pack",
    mettl: "Founded and headquartered in India (Gurugram); serves companies internationally; strong India enterprise presence"
  },
  {
    criterion: "Proctoring",
    assessiq: "Optional fullscreen gate, copy/paste block and tab-switch warning (no webcam, no lockdown); server-side timers and an append-only audit log today",
    mettl: "AI-powered proctoring at enterprise scale"
  },
  {
    criterion: "Question types",
    assessiq: "MCQ with per-student option shuffle, scenario and log-analysis questions, aptitude pack; coding tests (Coming soon)",
    mettl: "Broad library of 100,000+ questions across technical and behavioral domains; supports many assessment categories"
  },
  {
    criterion: "Code evaluation",
    assessiq: "Coding tests and live code execution (Coming soon); MCQ scored deterministically, written answers graded with AI assistance by AssessIQ evaluators",
    mettl: "Auto-graded coding simulators with support for multiple languages; part of their technical assessment suite"
  },
  {
    criterion: "Structured scoring",
    assessiq: "Anchor-based rubrics and scoring bands on every question; per-answer rationale visible to reviewer",
    mettl: "Scoring varies by assessment type; detailed candidate reports available; check vendor for rubric-level detail"
  },
  {
    criterion: "Integrations",
    assessiq: "Admin dashboard, results CSV per assessment, signed webhooks; ATS/HRMS integrations (Coming soon)",
    mettl: "Integrates with major HRMS and LMS platforms; wide enterprise integration catalog"
  },
  {
    criterion: "Deployment",
    assessiq: "Cloud SaaS; bulk invite via CSV import (up to 1,000 rows per file, or 200 when the same import also sends invitations) and email invites; invite links valid 7 days with resend",
    mettl: "Cloud SaaS; enterprise on-premise options may vary — confirm with vendor"
  },
  {
    criterion: "Support",
    assessiq: "Direct access to the team for setup and configuration questions",
    mettl: "Dedicated customer success for enterprise accounts; support scale varies by tier"
  },
  {
    criterion: "Company background",
    assessiq: "India-focused B2B assessment platform; structured hiring and institutional exams",
    mettl: "Acquired by Mercer (global HR consulting) in 2018; backed by global talent management brand"
  },
  {
    criterion: "Ideal customer",
    assessiq: "Indian IT companies, campus hiring teams, and educational institutions wanting structured, auditable assessment workflows",
    mettl: "Enterprises and institutions needing high-volume proctored exams, wide assessment variety, or global multi-country deployment"
  }
];

const faqs = [
  {
    q: "What is Mercer Mettl?",
    a: "Mercer Mettl (now branded Mercer | Mettl) is an online talent assessment and proctoring platform headquartered in Gurugram, India. It was acquired by Mercer in 2018. The platform is known for a broad assessment library, AI-powered proctoring, and enterprise-scale examination delivery used by 6,000+ companies globally."
  },
  {
    q: "How does AssessIQ differ from Mercer Mettl for Indian IT companies?",
    a: "AssessIQ is designed specifically for structured, auditable B2B hiring decisions — with anchor-based rubrics, scoring bands, and full attempt logs that let teams defend every shortlist decision. Mercer Mettl offers a wider enterprise assessment library and a large-scale proctoring infrastructure. For Indian IT companies that need a focused screening workflow with transparent scoring rationale, AssessIQ is the more direct fit. For enterprise exam programs, certification delivery, or very large question library breadth, Mercer Mettl is worth evaluating."
  },
  {
    q: "Does AssessIQ support AI-powered proctoring like Mercer Mettl?",
    a: "AssessIQ has basic integrity controls (an optional fullscreen gate, copy/paste blocking and a tab-switch warning, recorded for the admin) but no webcam proctoring and no lockdown browser; it also has server-side timers, an append-only audit log, and role-separated access. Mercer Mettl is known for AI-powered proctoring at very large scale. The right choice depends on the scale of your exam program and what oversight the proctoring output needs to support."
  },
  {
    q: "Is Mercer Mettl suitable for small and mid-size Indian companies?",
    a: "Mercer Mettl serves a wide range of business sizes from startups to enterprises. Some user reviews note that pricing can be a consideration for smaller organizations. AssessIQ is designed with Indian team sizes and hiring workflows in mind. Both platforms are worth evaluating based on your volume and feature requirements — check current pricing directly with each vendor."
  },
  {
    q: "Which platform has a larger question library — AssessIQ or Mercer Mettl?",
    a: "Mercer Mettl publicly states a library of 100,000+ technical questions across many domains. AssessIQ ships a smaller set of curated question packs, including an aptitude pack; more technical packs (Python, Java, SQL, React) are coming soon. If raw library count is the primary criterion, Mercer Mettl has far more volume."
  },
  {
    q: "How can I evaluate AssessIQ before committing?",
    a: "Contact us and we will set up a company account so you can run a real assessment against your hiring workflow before deciding."
  }
];
---

<BaseLayout
  hasDatedNode
  title="AssessIQ vs Mercer Mettl: 2026 Comparison"
  description="AssessIQ vs Mercer Mettl: 2026 comparison — India focus, proctoring, code evaluation, structured scoring, and which platform best fits your IT hiring needs."
  canonicalPath="/compare/assessiq-vs-mettl"
  ogType="article"
>
  <!-- JSON-LD: Article (separate block per §3.6) -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <!-- JSON-LD: FAQPage (separate block per §3.6) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- JSON-LD: BreadcrumbList (separate block per §3.6) -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Breadcrumb nav — visible, matches JSON-LD (SEO §3.8) -->
  <nav aria-label="Breadcrumb" class="border-b border-aiq-border bg-aiq-bg-raised">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-sm">
