---
// resources/release-campus-test-results.astro
// JSON-LD: Article (hasDatedNode, so BaseLayout skips its WebPage block), BreadcrumbList.
// Claims verified in code:
// - Modes: manual (default) and automatic, with the help text (modules/16-help-system/content/en/admin.yml, tenant-settings.tsx)
// - Complete result = every question has a final score; auto release only for results ready after the switch (modules/09-scoring/src/release.ts)
// - Release button and "Release all ready" (modules/10-admin-dashboard/src/components/ReleaseConfirmModal.tsx, assessment-detail/ReleaseResendBlock.tsx)
// - Result email on release (modules/13-notifications/src/email/result-released.ts)
// - Certificate created at release (modules/09-scoring/src/release.ts header, item 4)
import { getPageDates, formatDate } from '../../lib/page-dates';
import BaseLayout from '../../layouts/BaseLayout.astro';

const site = 'https://assessiq.in';
const dates = getPageDates('/resources/release-campus-test-results');
const canonicalPath = '/resources/release-campus-test-results';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How to release test results to students',
  datePublished: dates.published,
  dateModified: dates.modified,
  author: { '@type': 'Organization', name: 'AssessIQ' },
  publisher: {
    '@type': 'Organization',
    name: 'AssessIQ',
    logo: { '@type': 'ImageObject', url: `${site}/favicon.svg` },
  },
  image: `${site}/og-default.png`,
  mainEntityOfPage: `${site}${canonicalPath}`,
  description: 'How result release works for online tests: manual and automatic modes, what a student sees, and how to release results.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: `${site}/resources` },
    { '@type': 'ListItem', position: 3, name: 'Release test results to students' },
  ],
};
---

<BaseLayout
  hasDatedNode
  title="Release Test Results to Students Online"
  description="How test results reach students in AssessIQ: manual or automatic release, what a student sees, and the steps to release one result or all ready results."
  canonicalPath={canonicalPath}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <nav aria-label="Breadcrumb" class="border-b border-aiq-border bg-aiq-bg-raised">
    <div class="max-w-6xl mx-auto px-aiq-xl py-aiq-sm">
      <ol class="flex items-center gap-aiq-sm list-none m-0 p-0">
        <li>
          <a href="/" class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase hover:text-aiq-fg-secondary transition-colors">Home</a>
        </li>
        <li aria-hidden="true" class="font-mono text-aiq-xs text-aiq-fg-muted">&rsaquo;</li>
        <li>
          <a href="/resources" class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase hover:text-aiq-fg-secondary transition-colors">Resources</a>
        </li>
        <li aria-hidden="true" class="font-mono text-aiq-xs text-aiq-fg-muted">&rsaquo;</li>
        <li>
          <span class="font-mono text-aiq-xs text-aiq-fg-secondary tracking-aiq-mono uppercase" aria-current="page">Result release</span>
        </li>
      </ol>
    </div>
  </nav>

  <header class="bg-aiq-bg-base border-b border-aiq-border">
    <div class="max-w-4xl mx-auto px-aiq-xl py-aiq-4xl">
      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-lg m-0">
        Results &middot; Release
      </p>
      <h1 class="font-serif text-aiq-3xl sm:text-aiq-hero font-normal tracking-aiq-tighter text-aiq-fg-primary leading-[1.05] mb-aiq-xl mt-0">
        Release test results to students
      </h1>
      <p class="font-sans text-aiq-lg text-aiq-fg-secondary leading-relaxed mb-aiq-xl max-w-2xl">
        A student sees a result only after it is released. This page explains the two release modes, what a student sees, and how to release results.
      </p>
      <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase m-0">
        Published {formatDate(dates.published, true)} &middot; AssessIQ Editorial
      </p>
    </div>
  </header>

  <article class="bg-aiq-bg-base">
    <div class="max-w-4xl mx-auto px-aiq-xl py-aiq-4xl">

      <section aria-labelledby="modes" class="mb-aiq-4xl">
        <h2 id="modes" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
          Two release modes
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-aiq-lg">
          <div class="bg-aiq-bg-raised border border-aiq-border rounded-aiq-lg p-aiq-xl">
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">Manual (default)</h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              A finished result waits for you. The student sees nothing and gets no email until you release it.
            </p>
          </div>
          <div class="bg-aiq-bg-raised border border-aiq-border rounded-aiq-lg p-aiq-xl">
            <h3 class="font-serif text-aiq-xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-sm mt-0">Automatic</h3>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
              A result is released as soon as it is complete. The student sees the score and gets an email at once.
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="complete" class="mb-aiq-4xl">
        <h2 id="complete" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
          What counts as complete
        </h2>
        <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed mb-aiq-lg">
          A result is complete when every question has a final score. A result that is still being graded cannot be released.
        </p>
        <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">
          Written answers must have a final grade. A student never sees a partial or provisional score, in either mode.
        </p>
      </section>

      <section aria-labelledby="release-one" class="mb-aiq-4xl">
        <h2 id="release-one" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
          Release one result
        </h2>
        <ol class="flex flex-col gap-aiq-lg list-decimal pl-aiq-xl m-0">
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Open the test and go to the attempts list.</li>
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Find the attempts marked <strong class="text-aiq-fg-primary font-medium">Ready to release</strong>.</li>
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Open the attempt and select <strong class="text-aiq-fg-primary font-medium">Release</strong>.</li>
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Confirm in the dialog <em>Release result to candidate?</em>.</li>
        </ol>
      </section>

      <section aria-labelledby="release-all" class="mb-aiq-4xl">
        <h2 id="release-all" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
          Release all ready results
        </h2>
        <ol class="flex flex-col gap-aiq-lg list-decimal pl-aiq-xl m-0">
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Open the test page.</li>
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Select <strong class="text-aiq-fg-primary font-medium">Release all ready</strong>.</li>
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Confirm in the dialog <em>Release all ready results?</em>.</li>
        </ol>
      </section>

      <section aria-labelledby="switch" class="mb-aiq-4xl">
        <h2 id="switch" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
          Change the release mode
        </h2>
        <ol class="flex flex-col gap-aiq-lg list-decimal pl-aiq-xl m-0">
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Open the tenant settings and find <strong class="text-aiq-fg-primary font-medium">Result release</strong>.</li>
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Choose <strong class="text-aiq-fg-primary font-medium">Manual</strong> or <strong class="text-aiq-fg-primary font-medium">Automatic</strong>.</li>
          <li class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed">Save. You may need a fresh authenticator code. Each change is recorded in the audit log.</li>
        </ol>
        <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed mt-aiq-lg mb-0">
          Switching to automatic does not release results that are already waiting. Release those yourself.
        </p>
      </section>

      <section aria-labelledby="after" class="mb-aiq-4xl">
        <h2 id="after" class="font-serif text-aiq-3xl font-normal tracking-aiq-tight text-aiq-fg-primary mb-aiq-xl mt-0">
          What happens at release
        </h2>
        <ul class="list-none m-0 p-0 flex flex-col gap-aiq-md">
          <li class="flex gap-aiq-md">
            <span class="font-mono text-aiq-xs text-aiq-accent mt-1 shrink-0">&#8212;</span>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">The student receives an email that the result is ready.</p>
          </li>
          <li class="flex gap-aiq-md">
            <span class="font-mono text-aiq-xs text-aiq-accent mt-1 shrink-0">&#8212;</span>
            <p class="font-sans text-aiq-md text-aiq-fg-secondary leading-relaxed m-0">If the test issues a certificate, the certificate is created at release. See <a href="/resources/verify-skill-certificate" class="text-aiq-accent hover:text-aiq-accent-hover underline underline-offset-2">how to verify a skill certificate</a>.</p>
          </li>
        </ul>
      </section>

      <aside class="bg-aiq-bg-raised border border-aiq-border rounded-aiq-lg p-aiq-xl">
        <p class="font-mono text-aiq-xs text-aiq-fg-muted tracking-aiq-mono uppercase mb-aiq-md mt-0">Related reading</p>
        <ul class="list-none m-0 p-0 flex flex-col gap-aiq-md">
          <li><a href="/resources/how-to-run-a-campus-aptitude-test" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">How to run a campus aptitude test online</a></li>
          <li><a href="/resources/send-test-invitations-to-students" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">Send test invitations to students</a></li>
          <li><a href="/solutions/campus-recruitment" class="font-sans text-aiq-md text-aiq-accent hover:text-aiq-accent-hover transition-colors">Campus recruitment solution</a></li>
        </ul>
      </aside>

    </div>
  </article>
</BaseLayout>
