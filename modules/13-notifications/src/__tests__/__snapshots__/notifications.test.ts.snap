exports[`template snapshots — result_released (SP4) > HTML renders to a stable snapshot 1`] = `
"<!-- Composes kit partials. Result-released email (SP4, 2026-10-01); layout follows attempt_graded_candidate. Final score only — nothing per-question (owner rule P1). -->
