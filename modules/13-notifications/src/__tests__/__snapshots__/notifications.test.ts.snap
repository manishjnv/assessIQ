                    <td style="font-family:Georgia,'Times New Roman',serif;font-size:18px;font-weight:400;color:#0a0a0b;letter-spacing:-0.01em">
                      AssessIQ
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          
          <!-- A4 email-body — generous side padding -->
          <tr>
            <td style="padding:36px 40px;background:#ffffff">
              
                  <!-- A5 email-lede-editorial (30px H1) -->
                  <p style="margin:0 0 14px;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:11px;font-weight:500;color:#1a73e8;text-transform:uppercase;letter-spacing:0.08em">RESULT</p>
                  <h1 style="margin:0 0 14px;font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:500;color:#0a0a0b;letter-spacing:-0.02em;line-height:1.15">Your result is ready.</h1>
