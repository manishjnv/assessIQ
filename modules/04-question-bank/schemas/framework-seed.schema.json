{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "framework-seed.schema.json",
  "title": "Curriculum framework seed (RW-57)",
  "description": "Mirrors the Zod schema in src/framework-seeds.ts (the runtime validator; no JSON-schema library is installed). Maps to frameworks + taxonomy_nodes (migration 0169). board, sourceUrls and node description are validated but not stored: no column holds them.",
  "type": "object",
  "required": ["code", "name", "board", "version", "nodes"],
  "additionalProperties": false,
  "properties": {
    "code": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$", "description": "frameworks.slug; idempotency key" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "board": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Syllabus year or textbook edition; stored in taxonomy_nodes.syllabus_edition" },
    "sourceUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["code", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$", "description": "Unique among siblings; idempotency key" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300, "description": "taxonomy_nodes.label" },
        "kind": { "enum": ["board", "stage", "grade", "subject", "unit", "outcome", "criterion"] },
        "description": { "type": "string", "maxLength": 2000 },
        "externalId": { "type": "string", "maxLength": 128, "description": "taxonomy_nodes.external_id" },
        "children": { "type": "array", "items": { "$ref": "#/definitions/node" } }
      }
    }
  }
}
