# ---- Domain ----
ASSESSIQ_BASE_URL=https://assessiq.in
NODE_ENV=development

# ---- Observability ----
LOG_LEVEL=info
SENTRY_DSN=
# Optional. Absolute directory for per-stream JSONL log files (production: /var/log/assessiq).
# Unset = stdout only (modules/00-core/src/config.ts; docs/11-observability.md).
LOG_DIR=

# ---- Database (PostgreSQL 16) ----
# For local dev, point at a local Postgres or the Docker service.
# For production, the password is read from Docker secrets (secrets/pg_password.txt);
# the URL below uses the container service name as the host.
DATABASE_URL=postgres://assessiq:CHANGE_ME@localhost:5432/assessiq

# ---- Cache / Queue (Redis 7) ----
REDIS_URL=redis://localhost:6379

# ---- Master encryption key ----
# 32 bytes, base64-encoded. Used for AES-256-GCM envelope encryption of
# TOTP secrets, recovery codes, embed JWT secrets, and webhook signing keys.
# Generate: openssl rand -base64 32
ASSESSIQ_MASTER_KEY=
# ROTATION ONLY: the OLD key while re-encrypting (docs/06-deployment.md, MASTER_KEY rotation). Leave blank otherwise.
ASSESSIQ_MASTER_KEY_PREVIOUS=

# ---- Certificate signing ----
# HMAC secret for certificate credentials (modules/18-certification/src/crypto.ts).
# Required to issue or verify certificates; read from process.env, not config.ts.
# Generate: openssl rand -hex 32
CERT_SIGNING_SECRET=

# ---- Session ----
# 32 bytes, base64-encoded. Signs the session cookie.
# Generate: openssl rand -base64 32
SESSION_SECRET=
SESSION_COOKIE_NAME=aiq_sess

# ---- Embed JWT ----
# Controls how per-tenant embed secrets are provisioned.
# Allowed values: per-tenant (default) | shared (dev only)
EMBED_JWT_SECRET_PROVISION_MODE=per-tenant

# ---- Google OAuth (admin SSO) ----
# Provision at console.cloud.google.com → APIs & Services → Credentials.
# Redirect URI must match exactly: https://assessiq.in/api/auth/google/cb
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://assessiq.in/api/auth/google/cb
# Local dev:  http://localhost:3000/api/auth/google/cb
GOOGLE_OAUTH_REDIRECT=https://assessiq.in/api/auth/google/cb

# ---- Platform super admin ----
# Comma-separated emails allowed to sign in as super_admin (config.ts; the code
# default is the owner address). Set your own address in production.
# Required in production, no code default (the list lives only in the server environment).
SUPER_ADMIN_EMAILS=you@example.com
# Z-101: tester addresses that skip the Gmail dot/plus fold at sign-up (comma list). Empty = none.
SIGNUP_FOLD_EXEMPT_EMAILS=
# Fixed UUID of the platform tenant, seeded by modules/01-auth/migrations/016_super_admin.sql.
# Optional; the default below is the seed value.
PLATFORM_TENANT_ID=00000000-0000-7000-0000-000000000001
# RW-48b (2026-10-15): nightly purge of tenants archived for >= 180 days (worker only, job tenant-purge-cron 03:30 UTC).
# Unset or false = dry run (reports candidates, changes no rows). Set true only after a dry-run tick in the worker log
# ("tenant-purge-cron tick") shows the expected candidates. See docs/06-deployment.md.
TENANT_PURGE_ENABLED=false
# LC-2 (2026-10-16): nightly purge of users soft-deleted for >= 180 days (worker only, job user-purge-cron 03:45 UTC).
# Unset or false = dry run (reports candidates, changes no rows). Set true only after a dry-run tick in the worker log
# ("user_purge.tick") shows the expected counts. Rows stay as pseudonymised tombstones. See docs/06-deployment.md.
USER_PURGE_ENABLED=false

# ---- MFA gate ----
# true (production hardening) = admins/reviewers must complete TOTP after
# Google SSO before accessing protected routes; pre-MFA sessions land on
# /admin/mfa for enrolment.
# false (early-stage simplification) = Google SSO is the sole auth factor;
# requireAuth bypasses the totpVerified + freshMfa gates and the SSO callback
# redirects past /admin/mfa to returnTo or /admin/users.
# Flip to true once /admin/mfa enrolment UX has been browser-tested end-to-end.
# Existing sessions then re-prompt for TOTP because totpVerified stays false.
MFA_REQUIRED=true

# ---- Origin-verify anti-IP-spoof ----
# Shared secret Cloudflare injects as the x-origin-verify request header via a
# Cloudflare Transform Rule. The API trusts cf-connecting-ip only when this
# header is present and matches. Leave blank in dev/test/CI — boot works without it.
# Generate: openssl rand -hex 32
ORIGIN_VERIFY_SECRET=

# Controls how strictly the origin-verify header is enforced.
# Rollout order: off → log → enforce
#   off     (default) — legacy: trust cf-connecting-ip ?? req.ip, zero validation.
#                       Deploy this first; no behaviour changes until you move to log.
#   log     — same return value as off, but emits a structured warn when the
#             x-origin-verify header is absent or mismatched. Use to confirm
#             the Cloudflare Transform Rule is delivering the header correctly
#             before flipping to enforce.
#   enforce — only trusts cf-connecting-ip when x-origin-verify passes a
#             constant-time compare against ORIGIN_VERIFY_SECRET. On mismatch,
#             falls back to raw socket IP; cf-connecting-ip / x-forwarded-for
#             are ignored entirely.
ORIGIN_TRUST_MODE=off

# ---- Rate limiting (IP buckets — tiered by auth state) ----
# All vars are optional — Zod defaults produce the values below.
# Adjust in .env to tune per tier without a code change or image rebuild.
# Tier                                         Default     Env var
# pre-MFA admin / reviewer session             100/min/IP  RATE_LIMIT_IP_ADMIN
# verified admin (role+totpVerified=true)      5000/min/IP RATE_LIMIT_IP_VERIFIED_ADMIN (DoS ceiling only)
# candidate session (valid, role=candidate)  3000/min/IP RATE_LIMIT_IP_CANDIDATE_SESSION (DoS ceiling; per-user is the real cap)
# anonymous (no session / key)                 120/min/IP  RATE_LIMIT_IP_ANON
# API key (Bearer aiq_live_*)                  600/min/IP  RATE_LIMIT_IP_APIKEY
#
# NOTE: anon = 120 (raised from 30 on 2026-05-22). The pre-auth login bootstrap
# is anonymous — every protected-route load fires a whoami probe, and the login
# screen got 429'd at 30/min. This is a DoS knob only; credential brute-force is
# the separate RATE_LIMIT_CREDENTIAL bucket below, which is unaffected.
RATE_LIMIT_IP_ADMIN=100
RATE_LIMIT_IP_VERIFIED_ADMIN=5000
RATE_LIMIT_IP_USER=30
RATE_LIMIT_IP_ANON=120
RATE_LIMIT_IP_APIKEY=600
# Campus drive: 100-500 candidates behind ONE public IP (see rate-limit.ts header).
RATE_LIMIT_IP_CANDIDATE_SESSION=3000
# Per-route per-IP cap for magic-link entry routes (/take/start, /api/auth/candidate/verify-link).
RATE_LIMIT_IP_CANDIDATE_ENTRY=2000
# Per-tenant cap (all authenticated + API-key traffic of one tenant).
RATE_LIMIT_TENANT=6000
# Postgres pool size per process. max_connections=100 (default, unchanged).
# In docker compose, infra/docker-compose.yml overrides this per service:
# api 40 (API_PG_POOL_MAX) + worker 15 (WORKER_PG_POOL_MAX) + 2x5 system pools
# = 65, leaving ~32 for migrations / psql / backups. PG_POOL_MAX below only
# applies to non-compose runs (dev / tests).
PG_POOL_MAX=30
# FUT-10: login URL of the assessiq_system role, used only by withSystemRole (own pool).
# REQUIRED when NODE_ENV=production. Leave empty in dev and tests (the app pool is used).
# Value format: postgres://assessiq_system:<password>@<host>:5432/assessiq
# SYSTEM_DATABASE_URL=
# Size of that pool (default 5).
PG_SYSTEM_POOL_MAX=5

# Per-user bucket (auth-tier-aware)
# Tier                                         Default    Env var
# verified admin (role+totpVerified=true)       300/min   RATE_LIMIT_USER_VERIFIED_ADMIN
# candidate session                             120/min   RATE_LIMIT_USER_CANDIDATE
# pre-MFA admin                                  60/min   (hardcoded — not configurable)
RATE_LIMIT_USER_VERIFIED_ADMIN=300
RATE_LIMIT_USER_CANDIDATE=120

# Credential endpoint bucket (per-route per-IP — ALWAYS applies regardless of tier)
# Protects TOTP verify, TOTP recovery, enroll/confirm, email OTP request/verify.
# Applies to ALL session tiers including verified admins.
# Default    Env var
# 20/min     RATE_LIMIT_CREDENTIAL
RATE_LIMIT_CREDENTIAL=20

# ---- Email (SMTP) ----
# In development, leave SMTP_URL empty — emails are written to /var/log/assessiq/dev-emails.log.
#
# Production sends through Brevo SMTP (since 2026-09-20), STARTTLS on port 587:
#   SMTP_URL=smtp://<brevo-login, @ written as %40>:<brevo-smtp-key>@smtp-relay.brevo.com:587
# Use smtp://, not smtps://. Details: docs/06-deployment.md and docs/13-email-system.md.
# DO NOT use a personal Gmail app-password in production — From: leaks the personal address
# AND Gmail's shared SPF/DKIM fails DMARC against assessiq.in.
SMTP_URL=
EMAIL_FROM="AssessIQ <connect@assessiq.in>"
# Required in production. Comma-separated sender domains verified with the SMTP provider.
# The domain of EMAIL_FROM must appear here, or the API refuses to boot. Example: assessiq.in
EMAIL_VERIFIED_DOMAINS=
# Daily soft cap for BULK email (invitations, results, alerts). Extra bulk mail is held to 09:00 IST of the next
# day with room. Sign-in codes are never held. Default 250 (Brevo free plan: 300/day shared). Optional.
EMAIL_BULK_DAILY_CAP=250

# Turnaround shown to candidates whose result is emailed instead of shown on screen:
# "Your result will be emailed to r***@x.com <EVALUATION_TURNAROUND_TEXT>."
# Plain text; set it to the real evaluation SLA. Default when unset: "within 72 hours".
EVALUATION_TURNAROUND_TEXT="within 72 hours"

# ---- AI pipeline ----
# Controls which grading backend is active.
# Phase 1: claude-code-vps — grading runs as Claude Code CLI on the VPS
#           under the admin's Max subscription (sync-on-click, admin-in-the-loop).
# Phase 2: anthropic-api   — switches to a budgeted Anthropic API key
#           via @anthropic-ai/sdk in modules/07-ai-grading/runtimes/anthropic-api.ts.
AI_PIPELINE_MODE=claude-code-vps

# Controls the question-generation strategy introduced in Stage 1 type-sharded
# generation (docs/design/2026-05-09-type-sharded-generation.md).
# omnibus (default) — legacy single-skill generate-questions call for all types.
# sharded — fans out to per-type skills (generate-mcq, generate-log-analysis,
#            generate-scenario, generate-kql) with auto-weighted counts and
#            a 2-concurrent semaphore.
# Do NOT set to "sharded" until per-type skills are deployed on the VPS and
# Stage 1.5 evals pass. See modules/00-core/src/config.ts for Zod enum.
# Per-tenant column (ai_generate_mode) overrides this env var when non-NULL.
AI_GENERATE_MODE=omnibus

# ──────────────────────────────────────────────────────────────────────────────
# WARNING — DO NOT ADD ANTHROPIC_API_KEY HERE
#
# Phase 1 grading runs as the Claude Code CLI on the VPS under the admin's
# personal Max account subscription. There is NO Anthropic API key in Phase 1.
# Adding ANTHROPIC_API_KEY to this file or to any module's env is a hard-rule
# violation (CLAUDE.md rule #1 and docs/05-ai-pipeline.md § Compliance frame).
#
# Phase 2 will introduce a budgeted key, gated behind AI_PIPELINE_MODE=anthropic-api
# and imported only in modules/07-ai-grading/runtimes/anthropic-api.ts.
# ──────────────────────────────────────────────────────────────────────────────

# Optional, eval only (Z-163). Second key for the anthropic-api runtime: it is used when the first
# key is out of credit. Leave empty here. tools/run-eval-api.sh sets it for one eval process only.
# The app never reads a real value from this file while AI_PIPELINE_MODE=claude-code-vps.
ANTHROPIC_API_KEY_FALLBACK=

# Optional, anthropic-api runtime and eval only (Z-163): effort level sent to the 5.x models, one of
# low, medium, high, xhigh, max. Empty = the model default. Per-stage model override: set
# AI_API_MODEL_GRADE_ANCHORS, AI_API_MODEL_GRADE_BAND or AI_API_MODEL_GRADE_ESCALATE to a model id
# (default is the model in the skill frontmatter).
AI_API_EFFORT=

# Optional. Append-only log of questions rejected by the MCP submit_questions tool
# (tools/assessiq-mcp). Default: /var/log/assessiq/mcp-rejections.log.
MCP_REJECTION_LOG=
# Optional. Log file for the Stage 3 watch cron (tools/stage3-watch.ts).
# Default: /var/log/assessiq/stage3-watch.log.
STAGE3_WATCH_LOG=

# ---- AI grading eval ----
# Optional. Override the admin user id used for eval CLI runs
# (modules/07-ai-grading/eval/cli.ts). Unset = eval CLI derives it from DB.
AIQ_ADMIN_USER_ID=
# Eval gate on grading prompts (modules/07-ai-grading/src/eval-gate.ts).
# off | warn (default) | enforce. enforce blocks AI grading unless the live
# skill shas match a blessed baseline; never set enforce before the first bless.
AI_EVAL_GATE=warn
# Optional. Directory holding blessed eval baselines. Unset = modules/07-ai-grading/eval/baselines.
AIQ_EVAL_BASELINES_DIR=
# Eval experiments only. 1 = the eval CLI sends every case through Stage 3 (Opus) to measure its value. Never set in production.
EVAL_FORCE_ESCALATE=

# ---- Audit-log archival ----
# S3 bucket for audit-log cold archival (modules/14-audit-log/src/archive-job.ts).
S3_BUCKET=

# ---- Test minters (dev only) ----
# WARNING: both must be false (or unset) in production.
# ENABLE_EMBED_TEST_MINTER exposes a dev-only embed-session minting endpoint
# (apps/api/src/routes/auth/embed.ts).
ENABLE_EMBED_TEST_MINTER=false
# ENABLE_E2E_TEST_MINTER exposes a dev-only E2E session minting endpoint;
# guarded by a hard prod check in config.ts (commit bd0ceb0).
ENABLE_E2E_TEST_MINTER=false

# ---- Dev / test only ----
# Dev-only email log path used by lifecycle tests
# (modules/05-assessment-lifecycle/src/__tests__/lifecycle.test.ts).
ASSESSIQ_DEV_EMAILS_LOG=

# ---- E2E (Playwright) ----
# Base URL the Playwright runner targets (apps/web/e2e/fixtures/factories.ts).
PLAYWRIGHT_BASE_URL=http://localhost:5173
# API base URL used by E2E fixtures (apps/web/e2e/fixtures/factories.ts).
E2E_API_BASE_URL=http://localhost:3000
# Pre-minted candidate session token for the take-happy-path spec
# (apps/web/e2e/take-happy-path.spec.ts). Leave empty; populated by the test minter.
E2E_CANDIDATE_TOKEN=
# Local e2e stack only (apps/web/e2e/local-stack.sh): the Vite dev server proxies /api
# to this URL (apps/web/vite.config.ts). Leave unset otherwise.
E2E_API_PROXY=

# ---- Optional / deployment-specific (documented here; leave unset unless needed) ----
# PUBLIC_BASE_URL — public origin used for certificate PDF QR codes
#   (modules/18-certification/src/pdf/render.ts). Required when issuing PDFs.
# PUPPETEER_EXECUTABLE_PATH — Chromium path for PDF rendering; defaults to
#   /usr/bin/chromium (modules/18-certification/src/pdf/render.ts).
# TURNSTILE_SECRET — Cloudflare Turnstile secret for the public contact form
#   (apps/api/src/routes/contact.ts); unset = verification rejected in production.

# Self-serve organisation sign-up (Z-71). false (default) = the public sign-up routes answer 404.
# Also needs PLAN_TIERS_ENFORCED=true, TURNSTILE_SECRET + TURNSTILE_SITE_KEY, and Redis. See docs/06-deployment.md.
SIGNUP_ENABLED=false
TURNSTILE_SITE_KEY=
# SIGNUP_TURNSTILE_HOSTNAMES — optional comma list of hostnames the Turnstile widget may run on; unset = host of ASSESSIQ_BASE_URL.

# Real-exam camera (Batch A). CAMERA_ENFORCED=false (default) = no camera gate. Files go under CAMERA_STORAGE_DIR; the cap is in bytes.
CAMERA_ENFORCED=false
CAMERA_STORAGE_DIR=/var/lib/assessiq/camera
CAMERA_STORAGE_MAX_BYTES=5368709120
# Per-organisation camera cap (default 1 GiB); the upload path checks this, not the total
CAMERA_TENANT_STORAGE_MAX_BYTES=1073741824

# Plan tiers (PT1). false = gates and limits are no-ops (default). Flip only after the owner confirms no current tenant is blocked.
# EXP-14 licensed read. false (default) = the licensed_read RLS policies stay dormant: a licensed organisation sees its own copies only.
# true = it also reads the platform packs it holds an entitlement for. Flip only with the owner (ROADMAP EXP-41); clone-on-grant still runs.
LICENSED_READ=false

PLAN_TIERS_ENFORCED=false

# Free-plan AI kill switch. true = Free-tier tenants cannot start AI grading (only read when PLAN_TIERS_ENFORCED=true). Keep false unless platform staff stop Free AI grading.
FREE_PLAN_AI_DISABLED=false
